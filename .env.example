# .env.example — plshare2 자격증명 템플릿
#
# 이 파일은 커밋 대상입니다 (실 키 값 없음).
# 실제 값을 채운 .env 파일은 .gitignore에 의해 커밋되지 않습니다.
#
# 사용법:
#   cp .env.example .env
#   # .env 파일을 열어 실 값 입력
#
# 가이드: docs/10-operations/live-credentials-guide.md

# ─────────────────────────────────────────────
# Spring Boot 프로파일
# demo    = H2 인메모리 + Mock 어댑터 (자격증명 불필요)
# prod    = PostgreSQL + 실 어댑터 (아래 Spotify 필수)
# ─────────────────────────────────────────────
SPRING_PROFILES_ACTIVE=demo

# ─────────────────────────────────────────────
# Spotify OAuth 2.0 PKCE
# 출처: application-prod.yml spotify.client-id / spotify.client-secret
# prod 프로파일에서 SPOTIFY_CLIENT_ID, SPOTIFY_CLIENT_SECRET 은 필수 (기본값 없음)
# ─────────────────────────────────────────────
SPOTIFY_CLIENT_ID=
SPOTIFY_CLIENT_SECRET=

# Redirect URI — 기본값: http://localhost:8080/api/auth/spotify/callback
# Spotify 앱 대시보드에 등록된 URI와 정확히 일치해야 함
# 출처: application-prod.yml spotify.redirect-uri
SPOTIFY_REDIRECT_URI=

# FE 콜백 리다이렉트 — 기본값: http://localhost:3000/import
# 출처: application-prod.yml spotify.fe-redirect
FE_REDIRECT_URL=

# ─────────────────────────────────────────────
# Apple MusicKit (선택 — 없으면 Apple MusicKit 기능 비활성)
# 출처: application-prod.yml apple-music.*
# 발급 절차: docs/10-operations/live-credentials-guide.md §2
# ─────────────────────────────────────────────
APPLE_TEAM_ID=
APPLE_KEY_ID=

# p8 키를 한 줄로 변환: awk 'NF{printf "%s\\n", $0}' AuthKey_*.p8
# 출처: application-prod.yml apple-music.private-key-pem
APPLE_PRIVATE_KEY_PEM=

# Apple Music storefront (기본값: us)
# 출처: application-prod.yml apple-music.storefront
APPLE_STOREFRONT=

# ─────────────────────────────────────────────
# Google OAuth (예정 — be-user-identity-001 머지 후 키 이름 확정)
# 출처: application-prod.yml google 섹션 (미추가)
# ─────────────────────────────────────────────
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=

# ─────────────────────────────────────────────
# PostgreSQL (prod 프로파일 전용)
# 출처: application-prod.yml spring.datasource.*
# 기본값: jdbc:postgresql://localhost:5432/plshare / plshare / plshare
# ─────────────────────────────────────────────
DATABASE_URL=
DATABASE_USERNAME=
DATABASE_PASSWORD=

# ─────────────────────────────────────────────
# S3 호환 스토리지 (선택)
# 출처: application-prod.yml storage.*
# ─────────────────────────────────────────────
S3_BUCKET=
S3_ENDPOINT=
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_PUBLIC_BASE_URL=

# ─────────────────────────────────────────────
# Frontend (Next.js)
# 출처: docker-compose.yml NEXT_PUBLIC_API_BASE_URL
# 기본값: http://localhost:8080
# ─────────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=

# --- Storage (S3-compatible; prod 프로파일. SigV4 presign은 아직 stub) ---
S3_BUCKET=
S3_ENDPOINT=
S3_PUBLIC_BASE_URL=
